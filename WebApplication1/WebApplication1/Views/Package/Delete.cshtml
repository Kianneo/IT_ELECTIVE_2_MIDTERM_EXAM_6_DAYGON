@model WebApplication1.Models.Package
@{
    ViewData["Title"] = "Delete Package Record";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <div class="card bg-body-tertiary border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Delete Package Record</h5>
            </div>
            <div class="card-body">
                <p class="text-light">Are you sure you want to permanently delete this package record?</p>
                <dl class="row text-light mb-0">
                    <dt class="col-sm-4">Tracking No.</dt>
                    <dd class="col-sm-8"><code class="text-info fs-6">@Model.TrackingNumber</code></dd>

                    <dt class="col-sm-4">Recipient</dt>
                    <dd class="col-sm-8">@Model.RecipientName (@Model.UnitNumber)</dd>

                    <dt class="col-sm-4">Contact Number</dt>
                    <dd class="col-sm-8">@Model.ContactNumber</dd>

                    <dt class="col-sm-4">Courier</dt>
                    <dd class="col-sm-8">@Model.CourierCompany</dd>
                </dl>
            </div>
            <div class="card-footer bg-dark border-secondary d-flex gap-2 justify-content-end">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
                </form>
                <a asp-action="Index" class="btn btn-outline-light"><i class="bi bi-x-lg"></i> Cancel</a>
            </div>
        </div>
    </div>
</div>