@model IEnumerable<WebApplication1.Models.Package>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold text-body mb-0">Package Operations</h3>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2">Live System</span>
        </div>
        <p class="text-body-secondary small mb-0">Monitor, track, and process incoming resident packages in real time.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-2 d-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-printer"></i>
            <span>Print Report</span>
        </button>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-2 d-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-plus-lg"></i>
            <span class="fw-semibold">Register Package</span>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 rounded-3 stat-card bg-body p-3 shadow-sm position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 bottom-0 bg-primary" style="width: 4px;"></div>
            <div class="d-flex align-items-center justify-content-between ps-2">
                <div>
                    <span class="text-body-secondary small fw-semibold d-block mb-1">Total Logs</span>
                    <h2 class="fw-bold mb-0 text-body">@ViewBag.TotalCount</h2>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 rounded-3 stat-card bg-body p-3 shadow-sm position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 bottom-0 bg-warning" style="width: 4px;"></div>
            <div class="d-flex align-items-center justify-content-between ps-2">
                <div>
                    <span class="text-body-secondary small fw-semibold d-block mb-1">Awaiting Pickup</span>
                    <h2 class="fw-bold mb-0 text-warning">@ViewBag.WaitingCount</h2>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-3">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 rounded-3 stat-card bg-body p-3 shadow-sm position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 bottom-0 bg-success" style="width: 4px;"></div>
            <div class="d-flex align-items-center justify-content-between ps-2">
                <div>
                    <span class="text-body-secondary small fw-semibold d-block mb-1">Claimed Today</span>
                    <h2 class="fw-bold mb-0 text-success">@ViewBag.ClaimedTodayCount</h2>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 rounded-3 stat-card bg-body p-3 shadow-sm position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 bottom-0 bg-danger" style="width: 4px;"></div>
            <div class="d-flex align-items-center justify-content-between ps-2">
                <div>
                    <span class="text-body-secondary small fw-semibold d-block mb-1">Overdue (&ge;3 Days)</span>
                    <h2 class="fw-bold mb-0 text-danger">@ViewBag.OverdueCount</h2>
                </div>
                <div class="p-3 bg-danger-subtle text-danger rounded-3">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-secondary-subtle rounded-3 shadow-sm bg-body">
    <div class="card-header bg-body-tertiary border-bottom border-secondary-subtle p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-body border-secondary-subtle text-body-secondary"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control border-secondary-subtle bg-body text-body" placeholder="Search tracking #, resident name, unit..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select form-select-sm border-secondary-subtle bg-body text-body" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="WaitingForPickup" selected="@(ViewBag.StatusFilter == WebApplication1.Models.PackageStatus.WaitingForPickup)">Waiting for Pickup</option>
                    <option value="Claimed" selected="@(ViewBag.StatusFilter == WebApplication1.Models.PackageStatus.Claimed)">Claimed</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm px-3" title="Apply Filter"><i class="bi bi-filter"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3" title="Reset Filter"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-body-tertiary border-bottom border-secondary-subtle">
                <tr class="text-body-secondary small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                    <th class="ps-3 py-3">Tracking Code</th>
                    <th class="py-3">Recipient</th>
                    <th class="py-3">Courier</th>
                    <th class="py-3">Arrival Date</th>
                    <th class="py-3">Status</th>
                    <th class="text-end pe-3 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                            <span class="fw-semibold">No package records found</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        bool isOverdue = item.Status == WebApplication1.Models.PackageStatus.WaitingForPickup && (DateTime.Now - item.ArrivalDateTime).TotalDays >= 3;
                        <tr class="@(isOverdue ? "table-danger-subtle" : "")">
                            <td class="ps-3">
                                <span class="fw-bold text-primary font-monospace">@item.TrackingNumber</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-body text-capitalize">@item.RecipientName</div>
                                <span class="badge bg-body-tertiary text-body-secondary border border-secondary-subtle font-monospace mt-1">Unit @item.UnitNumber</span>
                            </td>
                            <td><span class="badge bg-body-tertiary text-body border border-secondary-subtle px-2 py-1">@item.CourierCompany</span></td>
                            <td class="small text-body-secondary">@item.ArrivalDateTime.ToString("MMM dd, yyyy • h:mm tt")</td>
                            <td>
                                @if (item.Status == WebApplication1.Models.PackageStatus.WaitingForPickup)
                                {
                                    <span class="badge badge-soft-warning px-2 py-1"><i class="bi bi-clock me-1"></i> Waiting</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-success px-2 py-1"><i class="bi bi-check-circle me-1"></i> Claimed</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-ghost-secondary rounded-2" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-ghost-warning rounded-2" title="Edit Package">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-icon btn-ghost-danger rounded-2" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id" title="Delete Record">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                    @if (item.Status == WebApplication1.Models.PackageStatus.WaitingForPickup)
                                    {
                                        <button type="button" class="btn btn-sm btn-success ms-2 d-inline-flex align-items-center gap-1 px-3 rounded-2" data-bs-toggle="modal" data-bs-target="#claimModal-@item.Id">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                            <span>Claim</span>
                                        </button>
                                    }
                                </div>

                                <div class="modal fade text-start" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-body border-secondary-subtle shadow">
                                            <div class="modal-header border-secondary-subtle">
                                                <h5 class="modal-title text-danger fs-6 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Package Record</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-body">
                                                Are you sure you want to permanently remove tracking number <strong class="font-monospace text-primary">@item.TrackingNumber</strong> assigned to <strong>@item.RecipientName</strong>?
                                            </div>
                                            <div class="modal-footer border-secondary-subtle bg-body-tertiary">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (item.Status == WebApplication1.Models.PackageStatus.WaitingForPickup)
                                {
                                    <div class="modal fade text-start" id="claimModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content bg-body border-secondary-subtle shadow">
                                                <form asp-action="ConfirmClaim" asp-route-id="@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header border-secondary-subtle">
                                                        <h5 class="modal-title text-success fs-6 fw-bold"><i class="bi bi-box-seam me-2"></i> Confirm Package Claim</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-body">
                                                        <div class="p-3 bg-body-tertiary border border-secondary-subtle rounded-3 mb-3">
                                                            <div class="small text-body-secondary mb-1">Tracking Code: <strong class="font-monospace text-primary">@item.TrackingNumber</strong></div>
                                                            <div class="small text-body-secondary">Resident: <strong>@item.RecipientName</strong> (Unit @item.UnitNumber)</div>
                                                        </div>
                                                        
                                                        <div class="mb-2">
                                                            <label class="form-label fw-semibold small">Collected By Name</label>
                                                            <input type="text" name="claimedBy" class="form-control form-control-sm border-secondary-subtle bg-body text-body" value="@item.RecipientName" required />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-secondary-subtle bg-body-tertiary">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg me-1"></i> Complete Pickup</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>